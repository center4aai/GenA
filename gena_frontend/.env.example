# Same-origin API proxy (nginx in prod, vite dev proxy in dev)
VITE_DATASET_API_URL=/api/dataset
VITE_AGENT_API_URL=/api/agent
VITE_CHUNKER_URL=/api/chunker
# Auth: disabled (default, open UI) or enabled (JWT login required)
VITE_AUTH_MODE=disabled
# Default UI language: en | ru
VITE_DEFAULT_LOCALE=en
