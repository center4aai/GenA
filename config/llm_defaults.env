# Non-secret LLM defaults shared by gen_env.sh, agent_api/config.py and the chunker.
# Edit this file to point GenA at your own models. API keys are never stored here:
# an endpoint names the environment variable that holds its key (api_key_env),
# and the value goes into .env.

# ── Default LLM (any OpenAI-compatible API) ──
# Used when a task does not name a model.
LLM_URL_MODEL=http://vllm:8000/v1
LLM_MODEL_NAME=Qwen/Qwen3-32B

# ── Models offered in the UI ──
# JSON list; the first entry is the default model in the UI.
# Fields: id, name, base_url, model_name, and either api_key_env (name of the
# variable with the key) or api_key ("none" for servers without auth);
# optional extra: provider kwargs, e.g. {"reasoning_effort":"none"} for a
# thinking model served by Ollama.
# Host names (vllm, ollama) are containers on the compose network or any DNS
# name; private IP addresses must be listed in OUTBOUND_ALLOWED_CIDRS.
MODEL_ENDPOINTS='[{"id":"vllm-default","name":"Qwen3 32B (vLLM)","base_url":"http://vllm:8000/v1","model_name":"Qwen/Qwen3-32B","api_key_env":"LLM_API_KEY"},{"id":"ollama-example","name":"Qwen3 8B (Ollama)","base_url":"http://ollama:11434/v1","model_name":"qwen3:8b","api_key":"none","extra":{"reasoning_effort":"none"}}]'

# ── Optional model discovery and network access ──
# ArgoCD with vllm-* applications: lists cluster models (also needs ARGOCD_PASSWORD).
ARGOCD_URL=
# LiteLLM gateway through which discovered models are called (key: LITELLM_API_KEY).
LITELLM_BASE_URL=
# Private networks (comma-separated CIDRs) agent_api may call despite the SSRF filter.
OUTBOUND_ALLOWED_CIDRS=

GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
YANDEX_CLOUD_MODEL=yandexgpt-5-lite/latest
LLM_PROVIDER=openai
MAX_LEN_USER_PROMPT=32000

# ── Chunker: semantic sub-chunking (chonkie) ──
# CHUNKER_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# CHUNKER_SEMANTIC_CHUNK_SIZE=512
# CHUNKER_SEMANTIC_THRESHOLD=0.5
# CHUNKER_SEMANTIC_SPLIT_CHARS=2000
# CHUNKER_MIN_MERGE_CHARS=300
