# MongoDB
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_HOST=
MONGO_PORT=
MONGO_DB_NAME=

# Milvus
MILVUS_HOST=
MILVUS_PORT=
MILVUS_ENABLED=false

# API

LLM_MODEL_NAME=
LLM_URL_MODEL=
LLM_API_KEY=
# Приватные сети (CIDR через запятую), куда agent_api разрешено ходить вопреки SSRF-фильтру,
# например LLM-эндпоинт во внутренней сети: OUTBOUND_ALLOWED_CIDRS=192.168.10.0/24.
# Пусто (по умолчанию) — блокируются все не-глобальные адреса.
OUTBOUND_ALLOWED_CIDRS=

AGENT_API_URL=http://agent_api:8790

# Embedding
TEI_MODEL_NAME=
TEI_URL_EMBEDDER=
TEI_API_KEY=

API_DATASET_URL=http://dataset_api:8789
DATASET_API_URL=http://dataset_api:8789
TASK_QUEUE_API_URL=http://dataset_api:8789

# LLM
MAX_LEN_USER_PROMPT=

# GigaChat / Yandex (несекретные дефолты см. config/llm_defaults.env — один источник для gen_env и приложений)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=
GIGACHAT_MODEL=
GIGACHAT_VERIFY_SSL=true

YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_MODEL=

LLM_PROVIDER=openai

# Additional model endpoints (JSON array), example:
# MODEL_ENDPOINTS=[{"id":"qwen3-8-27b-lab","name":"Qwen 3.8 27B","base_url":"http://<vllm-host>:8000/v1","model_name":"qwen3.8-27b","api_key_env":"LLM_API_KEY"}]
# With provider: MODEL_ENDPOINTS=[{"id":"gigachat-2","name":"GigaChat-2","provider":"gigachat","base_url":"","model_name":"GigaChat-2","api_key":"<credentials>","extra":{"scope":"GIGACHAT_API_PERS"}}]
MODEL_ENDPOINTS=

# ArgoCD платформы — список и статус развёрнутых моделей, например http://<argocd-host>.
# Discovery через ArgoCD выключен, пока пусты ARGOCD_URL (по умолчанию) или ARGOCD_PASSWORD.
ARGOCD_URL=
ARGOCD_USERNAME=admin
ARGOCD_PASSWORD=

# LiteLLM-шлюз платформы — адрес и ключ для вызова моделей ArgoCD-кластера
# (доступны только через него), например http://litellm:4000/v1; пусто (по умолчанию) — не опрашивается.
# LITELLM_API_KEY — виртуальный ключ GenA, может быть пуст.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Auth (set AUTH_DISABLED=false and passwords to enable JWT)
AUTH_DISABLED=false
EXPERT_USERNAME=admin
EXPERT_PASSWORD=
USER_USERNAME=user
USER_PASSWORD=
WORKER_API_KEY=
JWT_SECRET=
# JWT: срок жизни токена в минутах; алгоритм читается dataset_api/config.py, но
# auth_utils.py подписывает/проверяет строго HS256 — не менять.
ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_ALGO=HS256

# Dataset API: CORS (пусто = middleware не подключается, SPA ходит same-origin через nginx)
# и лимит размера загружаемого исходного документа в байтах.
CORS_ORIGINS=
RAW_DOCUMENT_MAX_BYTES=52428800

# Task worker → dataset API auth (required in production).
# gen_env.sh по умолчанию берёт EXPERT_USERNAME/EXPERT_PASSWORD.
DATASET_API_USER=admin
DATASET_API_PASS=
WORKER_TOKEN_TTL=3600

# Task worker: URL чанкера и таймауты (LLM call, chunking по HTTP; optional)
CHUNKER_URL=http://chunker:8517
WORKER_CHUNK_TIMEOUT=1800
# Таймаут воркера на chunk-задачу с методом llm (больше CHUNKER_PROCESS_TIMEOUT_LLM).
WORKER_CHUNK_TIMEOUT_LLM=7200
WORKER_AGENT_TIMEOUT=600

# Chunk gate LLM call timeout, seconds (optional). Covers the cold model load
# on the first gate call of a run, not just inference.
GATE_LLM_TIMEOUT=180
# Other LLM chains (generation, validation, refine, assessments): per-call timeout
# in seconds and SDK retry count. Retries multiply load on a busy host; keep low.
LLM_TIMEOUT=90
LLM_MAX_RETRIES=1
# /models/health/: test chat request (max_tokens=1) to every model once per this
# many seconds; 0 disables it (then health only checks the model is in /models).
MODEL_SMOKE_INTERVAL_SEC=900
WORKER_AGENT_MAX_RETRIES=2

# Task worker: опрос очереди, ретраи и recovery зависших задач (см. task_worker/config.py)
WORKER_POLL_INTERVAL=5
WORKER_BATCH_SIZE=5
WORKER_MAX_RETRIES=3
WORKER_STUCK_THRESHOLD_MINUTES=15
WORKER_RECOVERY_INTERVAL_SECONDS=300
WORKER_HEARTBEAT_SECONDS=60
WORKER_MAX_TASK_ATTEMPTS=3
WORKER_REVALIDATION_CONCURRENCY=1
# WORKER_ID задаёт docker-compose.yaml (= TASK_WORKER_CONTAINER_NAME), чтобы
# владение задачами переживало рестарт контейнера.

# Web (host port for gena_frontend HTTPS SPA; defaults to 27371 if unset)
WEB_PORT=27371

# Same-origin API proxy paths baked into the SPA at build time
VITE_DATASET_API_URL=/api/dataset
VITE_AGENT_API_URL=/api/agent
VITE_CHUNKER_URL=/api/chunker
VITE_AUTH_MODE=disabled
# UI default language: en | ru (gen_env.sh sets ru for dev, en for prod if unset)
VITE_DEFAULT_LOCALE=en

# Chunker: лимит загрузки и таймаут обработки одного документа, сек.
CHUNKER_MAX_UPLOAD_BYTES=52428800
CHUNKER_PROCESS_TIMEOUT=1800
# Таймаут чанкера для метода llm (сегментация моделью), сек.
CHUNKER_PROCESS_TIMEOUT_LLM=7000
# Chunker: размеры чанков прозы (учебник/энциклопедия), символы.
CHUNKER_TEXTBOOK_TARGET_CHARS=1500
CHUNKER_TEXTBOOK_MAX_CHARS=2000
CHUNKER_TEXTBOOK_LIST_HARD_CAP=6000
CHUNKER_PROSE_MIN_CHARS_TEXTBOOK=400
CHUNKER_PROSE_MIN_CHARS_ENCYCLOPEDIA=200
CHUNKER_PROSE_DEBRIS_MAX_CHARS=120
# Chunker: заголовки разделов учебника, которые выбрасывать / оставлять
# (через запятую, поверх встроенных правил), и дополнительные сокращения.
CHUNKER_TEXTBOOK_DROP_HEADINGS=
CHUNKER_TEXTBOOK_KEEP_HEADINGS=
CHUNKER_ABBREVIATIONS_EXTRA=
# Chunker, метод layout: нумерованные подзаголовки в начале абзаца («1 Влияние Победы.»)
# как заголовки 3 уровня и разбор колонок внутри врезок (1 = включено, 0 = как раньше).
CHUNKER_LAYOUT_RUNIN_HEADINGS=1
CHUNKER_LAYOUT_COLUMNS=1
# Chunker: метод semantic — OpenAI-совместимый эндпоинт эмбеддингов (…/v1) и модель.
CHUNKER_EMBEDDING_URL=http://embedder:80/v1
CHUNKER_EMBEDDING_MODEL=deepvk/USER-bge-m3
# Сервис embedder (TEI): модель Hugging Face и индекс GPU.
EMBEDDER_MODEL_ID=deepvk/USER-bge-m3
EMBEDDER_GPU_DEVICE=1
CHUNKER_EMBEDDING_API_KEY=none
CHUNKER_EMBEDDING_TIMEOUT=60
CHUNKER_SEMANTIC_THRESHOLD=0.5
CHUNKER_SEMANTIC_PERCENTILE=20
# Chunker: метод llm — модель из MODEL_ENDPOINTS (пусто = LLM_URL_MODEL), окно, параллельность, таймауты.
CHUNKER_LLM_SEG_MODEL_ID=
CHUNKER_LLM_SEG_WINDOW_CHARS=12000
CHUNKER_LLM_SEG_CONCURRENCY=2
CHUNKER_LLM_SEG_WINDOW_TIMEOUT=240
CHUNKER_LLM_SEG_MAX_WINDOWS=400
CHUNKER_LLM_SEG_CONTEXT_PARAS=3
CHUNKER_LLM_SEG_MAX_TOKENS=3000
# Метод llm: сегмент модели — единица чанка до этого размера (символы); врезка короче
# этого выбрасывается (inset_short).
CHUNKER_LLM_SEG_MAX_CHARS=4000
CHUNKER_LLM_SEG_INSET_MIN_CHARS=80

#DOCKER
GENA_NET=gena_net

AGENT_API_CONTAINER_NAME=agent_api
GENA_FRONTEND_CONTAINER_NAME=gena_frontend
DATASET_API_CONTAINER_NAME=dataset_api
TASK_WORKER_CONTAINER_NAME=task_worker
GENA_CHUNKER_CONTAINER_NAME=chunker
GENA_EMBEDDER_CONTAINER_NAME=embedder
